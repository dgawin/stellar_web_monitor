# --- Image (nur Portainer-Stack) ---
# von GitHub Actions gebaut (Standardwert, nur bei eigenem Fork anpassen)
IMAGE=ghcr.io/dgawin/stellar_web_monitor:latest

# --- Cluster (Northbound API) ---
# CLUSTER_IP: IP eines beliebigen APs / des PVC. Der aktuelle PVC wird per system.getPvc ermittelt (RESOLVE_PVC=1).
CLUSTER_IP=192.168.1.10
CLUSTER_PORT=8080
CLUSTER_HTTPS=0
# Laut API-Doku ist nur "Administrator" erlaubt
CLUSTER_USER=Administrator
# Klartext oder bereits MD5-Hash (32 Hex-Zeichen). Die API erwartet MD5; auto = Klartext wird gehasht.
CLUSTER_PASSWORD=
CLUSTER_PASSWORD_HASH=auto
RESOLVE_PVC=1

# --- Datenschutz ---
# 1 = keine MAC-Adressen/Gerätenamen speichern, IPs kürzen (Standard)
PRIVACY_MODE=1
# mask = 192.168.20.x | full | off
PRIVACY_IP=mask

# --- Poller ---
POLL_INTERVAL=60
SYSINFO_EVERY=10
# leer = 7 Tage im Datenschutzmodus, sonst 90
RETENTION_DAYS=
LOGIN_BACKOFF_MAX=30

# --- Webseite ---
WEB_PORT=8088
SITE_TITLE=WLAN-Übersicht
REFRESH_SECONDS=30
WEB_USER=
WEB_PASSWORD=
DEBUG_PASSWORD=
TZ=Europe/Berlin
